# Native Wayland rendering and GNOME palette integration are product
# requirements, not optional developer conveniences. snipsnap-annotator is a
# python3 script that drives gsettings; neither dependency is guaranteed by
# the Qt stack on a minimal install.
Depends:
 ${misc:Depends},
 ${shlibs:Depends},
 hicolor-icon-theme,
 qt6-qpa-plugins (>= 6.2.4~),
 qt6-wayland (>= 6.2.4~),
 qt6-gtk-platformtheme (>= 6.2.4~),
 python3,
 libglib2.0-bin,
 dconf-cli,
Recommends:
